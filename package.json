{
  "name": "storybook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server/storybookServer.mjs",
    "test": "node --test tests/hardening.test.mjs",
    "deploy": "npm run build && tar --no-xattrs -C dist -czf - . | ssh clmt.ai 'rm -rf /var/www/learnandplay/storybook && mkdir -p /var/www/learnandplay/storybook && tar -C /var/www/learnandplay/storybook -xzf -'"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
